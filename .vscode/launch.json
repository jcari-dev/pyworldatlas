{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PyWorldAtlas: Full Playground",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/playground.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "PyWorldAtlas: Audit Every Record",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/playground.py",
      "args": ["--audit-only"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "PyWorldAtlas: Explore Japan",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/playground.py",
      "args": ["--country", "Japan"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}

